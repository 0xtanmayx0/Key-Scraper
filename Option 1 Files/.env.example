# Required: GitHub Personal Access Token (get from https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Discord webhook for real-time alerts
EXFIL_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: Data directory (defaults to ./data in project root)
DATA_DIR=./data

# Optional: Port (defaults to 7860)
PORT=7860
